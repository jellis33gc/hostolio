{
  "name": "Property",
  "properties": {
    "access_notes": {
      "description": "Alarm codes, pet warnings, parking instructions etc.",
      "type": "string"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "key_code": {
      "description": "Key safe/access code if applicable",
      "type": "string"
    },
    "key_reference": {
      "description": "Reference if a physical key is held in office",
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "postcode": {
      "type": "string"
    },
    "room_template": {
      "description": "Default list of rooms/areas for jobs at this property",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "address_line1"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "staff"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "staff"
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}