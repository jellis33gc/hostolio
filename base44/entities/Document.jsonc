{
  "name": "Document",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "doc_type": {
      "enum": [
        "id",
        "dbs_certificate",
        "right_to_work",
        "insurance",
        "qualification",
        "other"
      ],
      "type": "string"
    },
    "expiry_date": {
      "description": "Optional \u2014 not all document types expire",
      "format": "date",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "label": {
      "description": "Free-text label, useful when doc_type=other",
      "type": "string"
    },
    "staff_id": {
      "description": "User id of the staff member this document belongs to",
      "type": "string"
    },
    "uploaded_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "staff_id",
    "doc_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.staff_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}