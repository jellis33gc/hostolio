{
  "name": "Room",
  "properties": {
    "after_photos": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assigned_staff_id": {
      "description": "Denormalized from parent Job, for RLS",
      "type": "string"
    },
    "before_photos": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "company_id": {
      "description": "Denormalized from parent Job, for RLS",
      "type": "string"
    },
    "completion_notes": {
      "type": "string"
    },
    "initial_notes": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "severity_flag": {
      "default": "ok",
      "enum": [
        "ok",
        "pre_existing_damage",
        "needs_attention",
        "damage_occurred"
      ],
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "job_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.assigned_staff_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.assigned_staff_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.assigned_staff_id": "{{user.id}}"
        }
      ]
    }
  },
  "type": "object"
}