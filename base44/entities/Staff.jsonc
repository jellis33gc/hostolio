{
  "name": "Staff",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "company_id": {
      "type": "string"
    },
    "dbs_expiry": {
      "description": "Expiry date of background check, if applicable",
      "format": "date",
      "type": "string"
    },
    "dbs_status": {
      "default": "not_required",
      "enum": [
        "not_required",
        "pending",
        "cleared",
        "expired"
      ],
      "type": "string"
    },
    "employment_type": {
      "enum": [
        "employee",
        "subcontractor"
      ],
      "type": "string"
    },
    "hourly_rate": {
      "type": "number"
    },
    "skills": {
      "description": "Tags used for job eligibility filtering e.g. key_holder_trained, manual_handling, pet_friendly",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "user_id": {
      "description": "Linked User id for this staff member's login",
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}